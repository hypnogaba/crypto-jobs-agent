{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "nextrole",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crypto-jobs-agent",
      "database_id": "0bf4b998-cbdc-474b-b739-eb6e6e7d5a9d"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nextrole"
    }
  ],
  // Власний домен. workers.dev лишається робочим — зручно для перевірок,
  // але канонічною адресою в robots і sitemap є nextrole.info.
  "routes": [
    { "pattern": "nextrole.info", "custom_domain": true },
    { "pattern": "www.nextrole.info", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
