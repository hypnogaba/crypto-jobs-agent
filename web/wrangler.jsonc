{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "nextrole",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crypto-jobs-agent",
      "database_id": "0bf4b998-cbdc-474b-b739-eb6e6e7d5a9d"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nextrole"
    }
  ],
  // Власні домени, і лише вони: workers.dev вимкнено нижче, тож єдиний шлях
  // до Worker іде через зону nextrole.info — а отже, через її правила WAF.
  // Вебхук Telegram теж зареєстрований саме тут, а не на workers.dev.
  "routes": [
    { "pattern": "nextrole.info", "custom_domain": true },
    { "pattern": "www.nextrole.info", "custom_domain": true }
  ],
  // Маячок Cloudflare Web Analytics. Не секрет — він і так видимий у HTML,
  // і вміє лише слати перегляди в наш лічильник. Порожнє значення = вимкнено.
  "vars": {
    "WEB_ANALYTICS_TOKEN": "bf82f7bf13394b35bbc8df96c78e9daf"
  },
  // Вимкнено навмисно. nextrole.workers.dev віддавав той самий сайт другою
  // адресою — але головне не дубль у пошуку, а те, що цей хост іде повз зону
  // nextrole.info. Тобто жодне правило WAF на нього не діє, і краулер, якого
  // ми блокуємо на власному домені, спокійно заходив тут. Робочу перевірку
  // деплою робимо через `npm run preview`, він піднімає локально.
  "workers_dev": false,
  "observability": {
    "enabled": true
  }
}
