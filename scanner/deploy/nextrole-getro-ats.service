[Unit]
Description=NextRole: щотижневий збір роботодавців (посилань на ATS) з колекцій Getro
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/nextrole-scanner
EnvironmentFile=/etc/nextrole-scanner.env
ExecStart=/usr/bin/node dist/discover-getro-ats.js
StandardOutput=journal
StandardError=journal
TimeoutStartSec=7200
