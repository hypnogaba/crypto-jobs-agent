[Unit]
Description=NextRole — щоденний скан вакансій
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/nextrole-scanner
EnvironmentFile=/etc/nextrole-scanner.env
ExecStart=/usr/bin/node dist/scan.js
StandardOutput=journal
StandardError=journal
# Стеля пам'яті: чужа стрічка на гігабайт не має класти весь VPS.
# Node бере розмір купи з cgroup, тож 512M = ~256M купи — скан на цьому падав.
MemoryMax=4G
TimeoutStartSec=3600
