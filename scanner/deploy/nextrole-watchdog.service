[Unit]
Description=NextRole — watchdog, перевіряє результат дня
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/nextrole-scanner
EnvironmentFile=/etc/nextrole-scanner.env
ExecStart=/usr/bin/node dist/watchdog.js
StandardOutput=journal
StandardError=journal
# Стеля пам'яті: чужа стрічка на гігабайт не має класти весь VPS.
MemoryMax=512M
TimeoutStartSec=3600
