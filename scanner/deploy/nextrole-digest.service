[Unit]
Description=NextRole — ранкова добірка вакансій
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/nextrole-scanner
EnvironmentFile=/etc/nextrole-scanner.env
ExecStart=/usr/bin/node dist/digest.js
StandardOutput=journal
StandardError=journal
# Стеля пам'яті: чужа стрічка на гігабайт не має класти весь VPS.
MemoryMax=512M
TimeoutStartSec=1800
