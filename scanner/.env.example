# Cloudflare D1. Токен потребує права D1:Edit.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# Необовʼязково. Без нього рівень R5 драбини пропускається.
ANTHROPIC_API_KEY=

FRESHNESS_DAYS=14
# Вікно для вакансій із тегом web3 (NextCryptoJob). NextRole лишається на
# FRESHNESS_DAYS: правило стоїть на читанні (nextrole-window.ts).
CRYPTO_FRESHNESS_DAYS=30
# discover (типово): Getro лише для щотижневого збору посилань на ATS.
# hybrid: щодня, але в кеш лише вакансії без публічного ATS. jobs: як до 13.09.
GETRO_MODE=discover
# 0 вимикає запит вилки в Greenhouse (pay_transparency) і Ashby (includeCompensation).
ATS_PAY=1
# 0 вимикає крипто-прохід speedrun (тег web3 за галуззю й ширше вікно).
SPEEDRUN_CRYPTO=1
DISTINCT_COMPANY_TARGET=7
WATCHDOG_FLOOR=5

# Розвідка джерел по твіттеру (discover-twitter). Токен 6551: https://6551.io/mcp
# Без нього щотижнева розвідка просто не запускається — це не помилка.
TWITTER_TOKEN=
